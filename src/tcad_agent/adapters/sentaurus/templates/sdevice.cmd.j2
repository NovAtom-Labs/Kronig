# Generated by NovAtom TCAD Agent Sentaurus compiler {{ compiler_version }}.
# Candidate deck. Native syntax, mesh and physics need release-specific review.
Electrode {
{% for contact in contacts %}  { Name="{{ contact.id }}" Voltage={{ contact.voltage }}{% if contact.work_function is not none %}{% if contact.schottky %} Schottky{% endif %} WorkFunction={{ contact.work_function }}{% endif %} }
{% endfor %}}

File {
  Grid="device.tdr"
  Plot="sdevice.tdr"
  Current="sdevice.plt"
  Output="sdevice.log"
{% if parameter_file %}  Parameters="{{ parameter_file }}"
{% endif %}}

Physics {
  Temperature={{ temperature }}
{% for line in physics_lines %}  {{ line }}
{% endfor %}}

Plot {
{% for field in plot_fields %}  {{ field }}
{% endfor %}}

Math {
  RelErrControl
  ExtendedPrecision
  Digits={{ digits }}
  Iterations={{ iterations }}
{% for line in math_lines %}  {{ line }}
{% endfor %}}

Solve {
{% if equilibrium_reduced %}  # Kronig: only an insulated gate is swept and every semiconductor contact sits at one
  # potential, so each bias point is thermal equilibrium and Poisson alone is exact.
{% endif %}{% if equations != "Poisson" %}  Coupled { Poisson }
{% endif %}  Coupled { {{ equations }} }
{% for ramp in ramps %}  NewCurrentPrefix="{{ ramp.prefix }}_"
  Quasistationary({{ " -DoZero" if skip_start_solve else "" }}
    InitialStep=0.02 MinStep=1e-6 MaxStep=0.05
    Goal { Name="{{ ramp.contact }}" Voltage={{ ramp.target }} }
  ) {
    Coupled { {{ equations }} }
    CurrentPlot(Time=(1))
  }
  Plot(FilePrefix="{{ ramp.prefix }}" NoOverWrite)
{% endfor %}{% if not ramps %}  Plot(FilePrefix="point_0000" NoOverWrite)
{% endif %}}
