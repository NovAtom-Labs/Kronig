// Generated by NovAtom TCAD Agent Sentaurus compiler {{ compiler_version }}.
// Candidate deck. Native syntax, mesh and physics need release-specific review.
Electrode {
{% for contact in contacts %}  { Name="{{ contact.id }}" Voltage={{ contact.voltage }}{% if contact.work_function is not none %} Schottky WorkFunction={{ contact.work_function }}{% endif %} }
{% endfor %}}

File {
  Grid="device.tdr"
  Plot="sdevice.tdr"
  Current="sdevice.plt"
  Output="sdevice.log"
}

Physics {
  Temperature={{ temperature }}
{% for line in physics_lines %}  {{ line }}
{% endfor %}}

Plot {
{% for field in plot_fields %}  {{ field }}
{% endfor %}}

Math {
  Extrapolate
  RelErrControl
  Digits={{ digits }}
  Iterations={{ iterations }}
}

Solve {
  Coupled { {{ equations }} }
{% for ramp in ramps %}  NewCurrentPrefix="{{ ramp.prefix }}_"
  Quasistationary(
    InitialStep=0.1 MinStep=1e-6 MaxStep=0.1
    Goal { Name="{{ ramp.contact }}" Voltage={{ ramp.target }} }
  ) {
    Coupled { {{ equations }} }
    CurrentPlot(Time=(1))
  }
  Plot(FilePrefix="{{ ramp.prefix }}" NoOverWrite)
{% endfor %}}
