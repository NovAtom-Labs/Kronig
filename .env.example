# Copy to .env and keep the real credential local. .env files are gitignored.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=ap-south-1
LLM_MODEL=bedrock/global.anthropic.claude-sonnet-4-6
TCAD_REASONING_EFFORT=medium
TCAD_WORKSPACE=.tcad-agent
TCAD_DEVSIM_PYTHON=
TCAD_KNOWLEDGE_INDEX=knowledge-sources/index/knowledge.sqlite3
TCAD_SKILLS_ROOT=skills

# ---------------------------------------------------------------------------
# Sentaurus over SSH (optional). DEVSIM keeps working with all of this left alone.
# Step-by-step guide: docs/operations/sentaurus-ssh-setup.md
# Check your setup any time with:  tcad-agent sentaurus-check
# ---------------------------------------------------------------------------
# "ssh" turns the SSH pathway on. ("remote" is the separate signed-HTTP service below.)
TCAD_SENTAURUS_RUNNER=ssh
# Address of the HPC and your login there. You must be on its network or VPN first.
TCAD_HPSC_HOST=
TCAD_HPSC_USER=
# Password for that login. Leave empty if you use an SSH key instead.
TCAD_HPSC_PASSWORD=
# Only change this if the HPC does not use the normal SSH port.
TCAD_HPSC_PORT=22
# Exact Sentaurus release on the HPC, e.g. O-2018.06-SP2 (the guide shows how to find it).
TCAD_SENTAURUS_VERSION=
# Folder on the HPC where jobs are created.
TCAD_HPSC_REMOTE_ROOT=~/novatom-labs/runs
# Only if the Sentaurus programs are NOT found automatically (see the guide). Use one:
#   a one-line command that makes them available, e.g.  module load sentaurus
TCAD_SENTAURUS_SETUP=
#   or the folder on the HPC that holds the sde and sdevice programs
TCAD_SENTAURUS_BIN=
#   and, if the HPC does not already provide it, the license server, e.g. 27020@licenses.example.edu
TCAD_SENTAURUS_LICENSE=
# Simulator used when a request does not name one: devsim or sentaurus.
# Saying "use Sentaurus" or "use DEVSIM" in a request always wins.
TCAD_BACKEND=devsim

# Optional signed-HTTP Sentaurus service (a different pathway; leave empty for SSH).
TCAD_SENTAURUS_ENDPOINT=
TCAD_SENTAURUS_SIGNING_PRIVATE_KEY=
TCAD_SENTAURUS_TRUSTED_PUBLIC_KEY=